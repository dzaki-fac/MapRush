# OPSIONAL.
# Di Vercel, WebSocket otomatis memakai wss://<domain-anda>/api/ws — env var tidak perlu diisi.
# Isi hanya jika ingin mengarahkan client ke server WebSocket eksternal.
# Harus wss:// di production (ws:// diblokir dari halaman HTTPS).
NEXT_PUBLIC_WS_URL=

# Port untuk WS server mandiri saat development lokal (default 8080).
PORT=8080
